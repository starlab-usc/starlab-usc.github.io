---
import InteractiveLogo from '../components/InteractiveLogo';
import logoUrl from '../../assets/STARLab_logo.svg?url';
import uscLogoUrl from '../../assets/usc_primary_monogram_cardinal_black.svg?url';
import uscLogoDarkUrl from '../../assets/usc_primary_monogram_gold_white.svg?url';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const navigation = [
  { href: '/', label: 'About' },
  { href: '/publications', label: 'Publications' },
  { href: '/people', label: 'People' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="StarLab" />
    <link rel="icon" type="image/svg+xml" href={logoUrl} />
    <title>{title ? `${title} | StarLab` : 'StarLab'}</title>
    <script is:inline>
      // Apply the saved preference before the first paint.
      let savedTheme;
      try { savedTheme = localStorage.getItem('theme'); } catch {}
      document.documentElement.dataset.theme =
        savedTheme === 'light' || savedTheme === 'dark'
          ? savedTheme
          : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    </script>
  </head>
  <body>
    <header class="banner" aria-label="StarLab">
      <InteractiveLogo client:load>
        <div class="lab-name">
          <div class="site-title"><a href="/" aria-label="StarLab home">StarLab</a></div>
          <p>
            <span>[S]tatistical</span>
            <span>[T]echniques</span>
            <span>for</span>
            <span class="reasoning-line">[A]utonomous [R]easoning</span>
          </p>
        </div>
      </InteractiveLogo>
      <nav aria-label="Main navigation">
        {navigation.map(({ href, label }) => (
          <a href={href} aria-current={currentPath === href ? 'page' : undefined}>{label}</a>
        ))}
        <button class="theme-toggle" type="button" role="switch" aria-label="Dark mode" aria-checked="false" title="Toggle dark mode">
          <span class="theme-thumb" aria-hidden="true">
          <svg class="theme-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z" />
          </svg>
          <svg class="theme-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
          </svg>
          </span>
        </button>
        <img class="usc-logo usc-logo--light" src={uscLogoUrl} alt="USC University of Southern California" width="120" height="40" />
        <img class="usc-logo usc-logo--dark" src={uscLogoDarkUrl} alt="USC University of Southern California" width="120" height="40" />
      </nav>
    </header>
    <main>
      {title && <h1>{title}</h1>}
      <slot />
    </main>
  </body>
</html>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
  const root = document.documentElement;
  const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
  const syncToggle = () => {
    const dark = root.dataset.theme === 'dark';
    toggle.setAttribute('aria-checked', String(dark));
    toggle.title = dark ? 'Switch to light mode' : 'Switch to dark mode';
  };
  syncToggle();
  let userSelected = false;
  try { userSelected = ['light', 'dark'].includes(localStorage.getItem('theme') ?? ''); } catch {}
  toggle.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    userSelected = true;
    try { localStorage.setItem('theme', root.dataset.theme); } catch {}
    syncToggle();
  });
  systemTheme.addEventListener('change', ({ matches }) => {
    if (userSelected) return;
    root.dataset.theme = matches ? 'dark' : 'light';
    syncToggle();
  });
</script>

<style is:global>
  :root {
    color-scheme: light;
    --page-bg: #faf9f6;
    --surface-bg: #fff;
    --text: #252525;
    --muted: #626262;
    --border: #e9e7e2;
    --hover-bg: #f0eeea;
    --hover-border: #dcd8d0;
    --card-bg: #efeeeb;
    --link: #3269a8;
    --divider: #2525251a;
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --page-bg: #202020;
    --surface-bg: #181818;
    --text: #efeeeb;
    --muted: #b8b6b1;
    --border: #383838;
    --hover-bg: #2d2d2d;
    --hover-border: #494949;
    --card-bg: #303030;
    --link: #8cbbef;
    --divider: #ffffff26;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; }
  body {
    background: var(--page-bg);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--text);
  }
  .banner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
    min-height: 128px;
    padding: 12px clamp(16px, 4vw, 64px);
    background: var(--surface-bg);
    border-bottom: 1px solid var(--border);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0;
  }
  .lab-name {
    min-width: 0;
    width: max-content;
    font-size: clamp(40px, 4vw, 48px);
  }
  .lab-name .site-title {
    margin: 0;
    font-size: 1em;
    font-weight: 650;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  .lab-name p {
    /* Let the title alone determine the shared width. */
    contain: inline-size;
    display: grid;
    grid-template-columns: repeat(3, max-content);
    justify-content: space-between;
    margin: 4px 0 0;
    font-size: 0.23em;
    line-height: 1.4;
    color: var(--muted);
    white-space: nowrap;
  }
  .lab-name .reasoning-line {
    grid-column: 1 / 3;
    /* Follow the first two words without changing their column widths. */
    contain: inline-size;
    text-align-last: justify;
  }
  .site-title a { color: inherit; text-decoration: none; }
  .usc-logo {
    display: block;
    width: 120px;
    height: auto;
    flex-shrink: 0;
  }
  .usc-logo--dark { display: none; }
  [data-theme="dark"] .usc-logo--light { display: none; }
  [data-theme="dark"] .usc-logo--dark { display: block; }
  nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
    margin-left: auto;
    padding: 16px 0 16px 24px;
  }
  nav a {
    color: inherit;
    text-decoration: none;
    font-weight: 500;
    padding: 8px 0;
  }
  nav a:hover, nav a[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  a:focus-visible, button:focus-visible { outline: 2px solid currentColor; outline-offset: 6px; }
  .theme-toggle {
    position: relative;
    flex-shrink: 0;
    width: 60px;
    height: 44px;
    margin-left: auto;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .theme-toggle::before {
    content: '';
    position: absolute;
    inset: 6px 0;
    border-radius: inherit;
    background: var(--hover-bg);
    border: 1px solid var(--muted);
  }
  .theme-toggle:hover::before { border-color: var(--text); }
  .theme-thumb {
    position: absolute;
    top: 10px;
    left: 4px;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--text);
    color: var(--surface-bg);
  }
  .theme-thumb svg { position: absolute; }
  .theme-moon { opacity: 0; transform: rotate(-90deg) scale(.5); }
  [data-theme="dark"] .theme-thumb { transform: translateX(28px); }
  [data-theme="dark"] .theme-sun { opacity: 0; transform: rotate(90deg) scale(.5); }
  [data-theme="dark"] .theme-moon { opacity: 1; transform: rotate(0) scale(1); }
  @media (prefers-reduced-motion: no-preference) {
    .theme-thumb { transition: transform 240ms ease, background-color 240ms ease, color 240ms ease; }
    .theme-thumb svg { transition: opacity 180ms ease, transform 240ms ease; }
    .theme-toggle::before { transition: background-color 240ms ease, border-color 240ms ease; }
  }
  /* The achromatic WebGL logo has a white backdrop; map it to the dark banner. */
  [data-theme="dark"] .logo { filter: invert(0.906); }
  main { padding: 40px clamp(16px, 4vw, 64px); }
  main h1 { margin: 0 0 16px; font-size: clamp(32px, 5vw, 48px); }
  main p { margin: 0; color: var(--muted); line-height: 1.6; }
  @media (max-width: 540px) {
    nav { width: 100%; margin-left: 0; padding-left: 0; gap: 10px; }
  }
  .logo {
    position: relative;
    width: 104px;
    height: 104px;
    flex-shrink: 0;
  }
  .logo__fallback {
    position: absolute;
    inset: 0;
    margin: auto;
    width: auto;
    height: 80px;
  }
  .logo__scene { position: absolute; inset: 0; }
  .logo[data-ready="true"] .logo__fallback { visibility: hidden; }
  @media (max-width: 540px) {
    .logo { width: 72px; height: 88px; }
    .logo__fallback { height: 56px; }
    .logo__scene { transform: scale(0.7); }
    .lab-name { font-size: clamp(28px, 7.4vw, 40px); }
    .usc-logo { width: 96px; }
  }
</style>
