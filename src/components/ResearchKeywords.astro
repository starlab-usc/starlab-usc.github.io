---
interface Props {
  keywords: string[];
  prefix: string;
}

const { keywords, prefix } = Astro.props;
if (!Array.isArray(keywords) || keywords.length === 0 || keywords.some((keyword) => typeof keyword !== 'string' || !keyword.trim())) {
  throw new Error('Research keywords must be a non-empty list of non-empty strings.');
}
---

<div class="research-keywords">
  <p class="keyword-summary">{prefix} {keywords.join(', ')}.</p>
  <div class="keyword-animation" aria-hidden="true" hidden>
    <span class="keyword-prefix">{prefix}</span>
    <span class="keyword-stage">
      {keywords.map((keyword) => <span class="keyword-measure">{keyword}</span>)}
      <span class="keyword-current" data-holding>{keywords[0]}</span>
    </span>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.research-keywords');
  if (root) {
    const animation = root.querySelector<HTMLElement>('.keyword-animation')!;
    const current = root.querySelector<HTMLElement>('.keyword-current')!;
    const keywords = Array.from(root.querySelectorAll('.keyword-measure'), (el) => el.textContent!);
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const holdDuration = 2200; // Two 1.1-second cursor blinks.
    let index = 0;
    let length = keywords[0].length;
    let deleting = true;
    let timer: ReturnType<typeof setTimeout> | undefined;

    const tick = () => {
      current.removeAttribute('data-holding');
      length += deleting ? -1 : 1;
      current.textContent = keywords[index].slice(0, length);
      let delay = deleting ? 20 : 85;
      if (length === 0) {
        index = (index + 1) % keywords.length;
        deleting = false;
        delay = 250;
      } else if (length === keywords[index].length) {
        deleting = true;
        current.setAttribute('data-holding', '');
        delay = holdDuration;
      }
      timer = setTimeout(tick, delay);
    };

    const sync = () => {
      clearTimeout(timer);
      const enabled = !reducedMotion.matches;
      root.classList.toggle('is-animated', enabled);
      root.classList.toggle('is-paused', document.hidden);
      animation.hidden = !enabled;
      if (enabled && !document.hidden) timer = setTimeout(tick, holdDuration);
    };

    reducedMotion.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
    sync();
  }
</script>

<style>
  .research-keywords { margin: 24px 0 30px; }
  .keyword-summary, .keyword-animation {
    font-size: clamp(19px, 2.5vw, 26px);
    line-height: 1.45;
  }
  .keyword-animation { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .35em; }
  .keyword-animation[hidden] { display: none; }
  .keyword-prefix { color: var(--muted); }
  .keyword-stage { display: grid; font-weight: 550; color: var(--link); }
  .keyword-stage > span { grid-area: 1 / 1; overflow-wrap: anywhere; }
  .keyword-measure { visibility: hidden; }
  .keyword-stage > span::after { content: '▎'; font-weight: 400; }
  .keyword-current[data-holding]::after { animation: cursor 1.1s step-end 2; }
  .is-paused .keyword-current::after { animation: none; }
  .is-animated .keyword-summary {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @keyframes cursor { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .keyword-current[data-holding]::after { animation: none; }
  }
</style>
