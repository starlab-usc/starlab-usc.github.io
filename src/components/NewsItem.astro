---
import { render, type CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'news'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
const date = new Date(`${entry.data.date}T00:00:00Z`);
const dateLabel = new Intl.DateTimeFormat('en-US', {
  month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
}).format(date);
---

<article class="news-item">
  <div class="news-meta">
    <time datetime={entry.data.date}>{dateLabel}</time>
    {entry.data.type && <span class="news-type">{entry.data.type}</span>}
  </div>
  <div>
    <h3>{entry.data.title}</h3>
    <p>{entry.data.summary}</p>
    <details>
      <summary>Read more<span class="sr-only">: {entry.data.title}</span></summary>
      <div class="news-body"><Content /></div>
    </details>
  </div>
</article>

<style>
  .news-item { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 24px; padding: 24px 0; }
  .news-item + .news-item { border-top: 1px solid var(--border); }
  .news-meta { padding-top: 3px; color: var(--muted); font-size: 14px; }
  time { display: block; }
  .news-type { display: block; margin-top: 6px; font-size: 12px; line-height: 1.4; }
  h3 { margin: 0 0 10px; font-size: 20px; font-weight: 550; line-height: 1.4; letter-spacing: -.015em; }
  summary { width: fit-content; margin-top: 14px; color: var(--link); cursor: pointer; }
  summary:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
  .news-body { margin-top: 20px; padding-left: 20px; border-left: 2px solid var(--border); }
  .news-body :global(p + p), .news-body :global(ul) { margin-top: 16px; }
  .news-body :global(h4) { margin: 24px 0 12px; font-size: 17px; }
  .news-body :global(a) { color: var(--link); text-underline-offset: 3px; overflow-wrap: anywhere; }
  .news-body :global(li) { margin: 8px 0; line-height: 1.6; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 600px) {
    .news-item { grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .news-body { padding-left: 14px; }
  }
</style>
