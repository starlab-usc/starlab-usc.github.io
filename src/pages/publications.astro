---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import arxivIcon from '../../assets/arxiv.svg?url';
import pdfIcon from '../../assets/pdf.svg?url';

interface Publication {
  title: string;
  authors: string[];
  year: number;
  venue: string;
  links: { label: string; url: string }[];
  note?: string;
}

const metadata = import.meta.glob<Publication>('../../assets/publications/*/index.json', {
  eager: true,
  import: 'default',
});
const citations = import.meta.glob<string>('../../assets/publications/*/citation.bib', {
  eager: true,
  query: '?raw',
  import: 'default',
});
const thumbnails = import.meta.glob<ImageMetadata>('../../assets/publications/*/thumbnail.png', {
  eager: true,
  import: 'default',
});
const publications = Object.entries(metadata).map(([path, publication]) => {
  const directory = path.slice(0, -'index.json'.length);
  const bibtex = citations[`${directory}citation.bib`];
  if (!bibtex) throw new Error(`Missing publication citation: ${directory}`);
  return {
    ...publication,
    id: directory.split('/').filter(Boolean).at(-1)!,
    bibtex,
    thumbnail: thumbnails[`${directory}thumbnail.png`],
  };
}).sort((a, b) => b.year - a.year || a.title.localeCompare(b.title));
const years = [...new Set(publications.map((publication) => publication.year))];
const resourceIcons: Record<string, string> = { arXiv: arxivIcon, PDF: pdfIcon };
---

<SiteLayout title="Publications">
  {years.map((year) => (
  <section aria-labelledby={`publication-year-${year}`}>
    <details class="year-group" open>
    <summary class="year-toggle"><h2 id={`publication-year-${year}`}>{year}</h2></summary>
    {publications.filter((publication) => publication.year === year).map((publication) => (
    <article aria-labelledby={`publication-${publication.id}`}>
      {publication.thumbnail ? (
      <Image
        class="publication-thumbnail"
        src={publication.thumbnail}
        alt=""
        widths={[132, 264]}
        sizes="132px"
        format="webp"
      />
      ) : (
      <div class="publication-thumbnail publication-thumbnail--empty" aria-hidden="true"></div>
      )}
      <div class="publication-info">
      <h3 id={`publication-${publication.id}`}>{publication.title}</h3>
      <p>{publication.authors.join(', ')}</p>
      {publication.note && <p class="publication-note">{publication.note}</p>}
      <div class="venue-line">
        <span class="venue">{publication.venue}, {publication.year}</span>
        {publication.links.map((link) => (
          <>
            <span class="separator" aria-hidden="true"> | </span>
            <a class="resource-link" href={link.url} aria-label={link.label} title={link.label}>
              {resourceIcons[link.label] ? (
                <img src={resourceIcons[link.label]} alt="" width="20" height="20" />
              ) : link.label}
            </a>
          </>
        ))}
        <span class="separator" aria-hidden="true"> | </span>
        <details>
          <summary>BibTeX</summary>
          <pre><code>{publication.bibtex}</code></pre>
        </details>
      </div>
      </div>
    </article>
    ))}
    </details>
  </section>
  ))}
</SiteLayout>

<style>
  section { max-width: 960px; }
  h2 { margin: 0; font-size: 24px; }
  .year-toggle { margin: 32px 0 16px; }
  article {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
    padding: 24px 0;
    border-radius: 4px;
  }
  article:focus-within {
    background: var(--hover-bg);
    box-shadow: 0 0 0 10px var(--hover-bg), 0 0 0 11px var(--hover-border);
  }
  @media (hover: hover) {
    article:hover {
      background: var(--hover-bg);
      box-shadow: 0 0 0 10px var(--hover-bg), 0 0 0 11px var(--hover-border);
    }
  }
  .publication-thumbnail { display: block; width: 132px; max-width: 100%; height: auto; }
  .publication-thumbnail--empty { aspect-ratio: 1; }
  @media (max-width: 640px) {
    article { grid-template-columns: minmax(0, 1fr); }
  }
  h3 { margin: 0 0 12px; font-size: 22px; line-height: 1.4; }
  .publication-note { color: var(--muted); font-size: 14px; margin-top: 4px; }
  .venue-line { margin-top: 4px; line-height: 1.8; }
  .venue, .separator { color: var(--muted); }
  .separator { margin: 0 6px; }
  a { color: inherit; text-underline-offset: 3px; }
  .resource-link, summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 24px;
    vertical-align: middle;
    border-radius: 4px;
  }
  :global([data-theme="dark"]) .resource-link img { filter: brightness(1.8); }
  .resource-link:hover, summary:hover { background: var(--hover-bg); }
  .venue-line > details { display: inline; }
  summary { cursor: pointer; width: fit-content; gap: 6px; }
  summary::-webkit-details-marker { display: none; }
  summary::before {
    content: '';
    width: 0;
    height: 0;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-left: 6px solid currentColor;
  }
  details[open] > summary::before { transform: rotate(90deg); }
  @media (prefers-reduced-motion: no-preference) {
    summary::before { transition: transform 180ms ease; }
  }
  pre {
    padding: 16px;
    background: var(--surface-bg);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 14px;
    line-height: 1.6;
  }
</style>
