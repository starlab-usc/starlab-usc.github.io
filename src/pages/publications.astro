---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PublicationsContent, { frontmatter } from './_publications.md';
import { frontmatter as peopleContent } from './_people.md';
import { z } from 'astro/zod';
import arxivIcon from '../../assets/arxiv.svg?url';
import pdfIcon from '../../assets/pdf.svg?url';

const { members } = z.object({
  members: z.array(z.object({
    name: z.string().min(1),
    group: z.string().optional(),
    publication_aliases: z.array(z.string().min(1)).optional(),
  })),
}).parse(peopleContent);
const peopleNames = new Set(members
  .filter(({ group }) => group !== 'affiliated')
  .flatMap(({ name, publication_aliases = [] }) => [name, ...publication_aliases]));

const page = z.object({
  title: z.string().min(1),
  bibtex_label: z.string().min(1),
  publications: z.array(z.object({
    id: z.string().regex(/^[a-z0-9_]+$/),
    title: z.string().min(1),
    authors: z.array(z.string().min(1)).min(1),
    year: z.number().int(),
    venue: z.string().min(1),
    links: z.array(z.object({ label: z.string().min(1), url: z.url() })),
    note: z.string().optional(),
  })),
}).parse(frontmatter);
if (new Set(page.publications.map(({ id }) => id)).size !== page.publications.length) {
  throw new Error('Publication IDs must be unique.');
}
const citations = import.meta.glob<string>('../../assets/publications/*/citation.bib', {
  eager: true,
  query: '?raw',
  import: 'default',
});
const thumbnails = import.meta.glob<ImageMetadata>('../../assets/publications/*/thumbnail.png', {
  eager: true,
  import: 'default',
});
const publications = page.publications.map((publication) => {
  const directory = `../../assets/publications/${publication.id}/`;
  const bibtex = citations[`${directory}citation.bib`];
  if (!bibtex) throw new Error(`Missing publication citation: ${directory}`);
  return {
    ...publication,
    bibtex,
    thumbnail: thumbnails[`${directory}thumbnail.png`],
  };
}).sort((a, b) => b.year - a.year || a.title.localeCompare(b.title));
const years = [...new Set(publications.map((publication) => publication.year))];
const resourceIcons: Record<string, string> = { arXiv: arxivIcon, PDF: pdfIcon };
---

<SiteLayout title={page.title}>
  <div class="page-introduction"><PublicationsContent /></div>
  {years.map((year) => (
  <section aria-labelledby={`publication-year-${year}`}>
    <details class="year-group" open>
    <summary class="year-toggle"><h2 id={`publication-year-${year}`}>{year}</h2></summary>
    {publications.filter((publication) => publication.year === year).map((publication) => (
    <article aria-labelledby={`publication-${publication.id}`}>
      {publication.thumbnail ? (
      <div
        class="publication-thumbnail"
        class:list={{ 'publication-thumbnail--expandable': publication.thumbnail.width !== publication.thumbnail.height }}
        tabindex={publication.thumbnail.width !== publication.thumbnail.height ? 0 : undefined}
        role="img"
        aria-label={`Figure for ${publication.title}`}
        style={`--thumbnail-width: ${132 * Math.max(1, publication.thumbnail.width / publication.thumbnail.height)}px`}
      >
      <div class="thumbnail-reveal">
      <Image
        src={publication.thumbnail}
        alt=""
        widths={[132, 264, 528, 1056]}
        sizes={`${132 * Math.max(1, publication.thumbnail.width / publication.thumbnail.height)}px`}
        format="webp"
      />
      </div>
      </div>
      ) : (
      <div class="publication-thumbnail publication-thumbnail--empty" aria-hidden="true"></div>
      )}
      <div class="publication-info">
      <h3 id={`publication-${publication.id}`}>{publication.title}</h3>
      <p>{publication.authors.map((author, index) => (
        <>{index > 0 && ', '}{peopleNames.has(author) ? <strong>{author}</strong> : author}</>
      ))}</p>
      {publication.note && <p class="publication-note">{publication.note}</p>}
      <div class="venue-line">
        <span class="venue">{publication.venue}, {publication.year}</span>
        {publication.links.map((link) => (
          <>
            <span class="separator" aria-hidden="true"> | </span>
            <a class="resource-link" href={link.url} aria-label={link.label} title={link.label}>
              {resourceIcons[link.label] ? (
                <img src={resourceIcons[link.label]} alt="" width="20" height="20" />
              ) : link.label}
            </a>
          </>
        ))}
        <span class="separator" aria-hidden="true"> | </span>
        <details>
          <summary>{page.bibtex_label}</summary>
          <pre><code>{publication.bibtex}</code></pre>
        </details>
      </div>
      </div>
    </article>
    ))}
    </details>
  </section>
  ))}
</SiteLayout>

<script>
  const expandableThumbnails = document.querySelectorAll<HTMLElement>('.publication-thumbnail--expandable');
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      expandableThumbnails.forEach((thumbnail) => { thumbnail.dataset.dismissed = ''; });
    }
  });
  expandableThumbnails.forEach((thumbnail) => {
    thumbnail.addEventListener('pointerenter', () => { delete thumbnail.dataset.dismissed; });
    thumbnail.addEventListener('focus', () => { delete thumbnail.dataset.dismissed; });
  });
</script>

<style>
  .page-introduction:empty { display: none; }
  .page-introduction { max-width: 780px; }
  .page-introduction :global(p + p) { margin-top: 18px; }
  .page-introduction :global(a) { color: var(--link); text-underline-offset: 3px; }
  section { max-width: 960px; }
  h2 { margin: 0; font-size: 24px; }
  .year-toggle { margin: 32px 0 16px; }
  article {
    container-type: inline-size;
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
    padding: 24px 0;
    border-radius: 4px;
  }
  article:focus-within {
    background: var(--hover-bg);
    box-shadow: 0 0 0 10px var(--hover-bg), 0 0 0 11px var(--hover-border);
  }
  @media (hover: hover) {
    article:hover {
      background: var(--hover-bg);
      box-shadow: 0 0 0 10px var(--hover-bg), 0 0 0 11px var(--hover-border);
    }
  }
  .publication-thumbnail {
    position: relative;
    width: 132px;
    max-width: 100%;
    aspect-ratio: 1;
  }
  .thumbnail-reveal {
    position: absolute;
    top: 0;
    left: 0;
    width: min(var(--thumbnail-width), 100cqi);
    clip-path: inset(0 max(0px, calc(100% - 132px)) max(0px, calc(100% - 132px)) 0);
    background: var(--page-bg);
    z-index: 1;
  }
  .thumbnail-reveal img { display: block; width: 100%; height: auto; }
  .publication-thumbnail--expandable:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
  .publication-thumbnail--expandable:not([data-dismissed]):focus-visible .thumbnail-reveal {
    clip-path: inset(0);
  }
  @media (hover: hover) {
    .publication-thumbnail--expandable:not([data-dismissed]):hover .thumbnail-reveal {
      clip-path: inset(0);
    }
  }
  @media (hover: none) {
    .publication-thumbnail--expandable:not([data-dismissed]):focus .thumbnail-reveal {
      clip-path: inset(0);
    }
  }
  @media (max-width: 640px) {
    article { grid-template-columns: minmax(0, 1fr); }
  }
  h3 { margin: 0 0 12px; font-size: 22px; line-height: 1.4; }
  .publication-note { color: var(--muted); font-size: 14px; margin-top: 4px; }
  .venue-line { margin-top: 4px; line-height: 1.8; }
  .venue, .separator { color: var(--muted); }
  .separator { margin: 0 6px; }
  a { color: inherit; text-underline-offset: 3px; }
  .resource-link, summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 24px;
    vertical-align: middle;
    border-radius: 4px;
  }
  :global([data-theme="dark"]) .resource-link img { filter: brightness(1.8); }
  .resource-link:hover, summary:hover { background: var(--hover-bg); }
  .venue-line > details { display: inline; }
  summary { cursor: pointer; width: fit-content; gap: 6px; }
  summary::-webkit-details-marker { display: none; }
  summary::before {
    content: '';
    width: 0;
    height: 0;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-left: 6px solid currentColor;
  }
  details[open] > summary::before { transform: rotate(90deg); }
  @media (prefers-reduced-motion: no-preference) {
    summary::before { transition: transform 180ms ease; }
    .thumbnail-reveal { transition: clip-path 180ms ease; }
  }
  pre {
    padding: 16px;
    background: var(--surface-bg);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 14px;
    line-height: 1.6;
  }
</style>
